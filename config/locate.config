process {
    // Every `locate`-CLI process (see modules/*/main.nf) runs in
    // docker://lvaleriani/locate:v1.3 -- built from the Dockerfile at the root
    // of the `locate` repo. This file only sets per-process publishDir.
    withName: 'BCFTOOLS_CONCAT' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/battenberg_phase/${meta.sampleID}/" },
                pattern: "*{vcf.gz,tbi}"
            ]
        ]
    }

    withName: 'PREPARE_TABLE_VCF' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'PREPARE_TABLE_SOMATIC_VCF' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'ALIGN_VAF' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'SPLIT_TABLE_BY_CHROM' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/" },
                pattern: "chrom_tables/*.csv"
            ]
        ]
    }

    withName: 'BIN_TABLE' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/binned/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'MERGE_BREAKPOINTS' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/segmentation/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'PREPARE_TABLE_METHYLATION' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'SEGMENTATION' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/segmentation/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'CN_INFERENCE' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/cn/" },
                pattern: "*.{csv,npz}"
            ]
        ]
    }

    withName: 'CN_EXPAND_SEGMENTS' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/cn/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'CN_PLOT' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/cn/" },
                pattern: "*.png"
            ]
        ]
    }

    withName: 'CN_DIAGNOSTIC_PLOT' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/cn/" },
                pattern: "*.png"
            ]
        ]
    }

    withName: 'METHYLATION_INFERENCE' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/methylation/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'CLASSIFY_POSTERIOR' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/methylation/classify_posterior/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'AGGREGATE_PROMOTERS' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/methylation/promoters/" },
                pattern: "*.csv"
            ]
        ]
    }
}

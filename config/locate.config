process {
    // The `locate` package processes below all still point at a placeholder
    // container ('TODO/locate:1.0.0') that has never been built/pushed.
    // Clearing `container` here makes these specific processes run directly
    // on the host (using whatever `locate` install is on PATH, e.g. a conda
    // env) even under -profile singularity, while every other module in the
    // pipeline still runs inside its real container. Remove these overrides
    // once a real locate image exists.
    withName: 'BCFTOOLS_CONCAT' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/battenberg_phase/${meta.sampleID}/" },
                pattern: "*{vcf.gz,tbi}"
            ]
        ]
    }

    withName: 'PREPARE_TABLE_VCF' {
        container = null
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'PREPARE_TABLE_SOMATIC_VCF' {
        container = null
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'ALIGN_VAF' {
        container = null
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'SPLIT_TABLE_BY_CHROM' {
        container = null
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/chrom/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'MERGE_BREAKPOINTS' {
        container = null
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/segmentation/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'PREPARE_TABLE_METHYLATION' {
        container = null
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/tables/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'SEGMENTATION' {
        container = null
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/segmentation/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'CN_INFERENCE' {
        container = null
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/cn/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'CN_EXPAND_SEGMENTS' {
        container = null
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/cn/" },
                pattern: "*.csv"
            ]
        ]
    }

    withName: 'METHYLATION_INFERENCE' {
        container = null
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/locate/${meta.sampleID}/methylation/" },
                pattern: "*.csv"
            ]
        ]
    }
}

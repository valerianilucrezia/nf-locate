// Genomics England Research Environment: use pre-imported local .sif images
// instead of pulling from Docker Hub (GEL RE has no outbound internet access;
// images must be imported ahead of time and referenced by local path).
//
// Set the two paths below to the imported .sif files' actual GEL RE paths,
// then every process that needs that image picks it up automatically --
// update these two lines when importing a new image version, instead of
// editing each process individually.
def LOCATE_SIF     = '/re_gecip/TODO/locate_v1.3.sif'          // TODO: set to the imported locate .sif's real path
def BATTENBERG_SIF = '/re_gecip/TODO/battenberg-phase_1.0.1.sif' // TODO: set to the imported battenberg-phase .sif's real path

process {
    // every locate-cli process (see modules/*/main.nf's `container 'docker://lvaleriani/locate:...'`)
    withName: 'PREPARE_TABLE_VCF|PREPARE_TABLE_SOMATIC_VCF|ALIGN_VAF|SPLIT_TABLE_BY_CHROM|BIN_TABLE|SEGMENTATION|MERGE_BREAKPOINTS|CN_INFERENCE|CN_EXPAND_SEGMENTS|CN_PLOT|CN_DIAGNOSTIC_PLOT|PREPARE_TABLE_METHYLATION|METHYLATION_INFERENCE|CLASSIFY_POSTERIOR|AGGREGATE_PROMOTERS' {
        container = LOCATE_SIF
    }

    withName: 'BATTENBERG_PHASE' {
        container = BATTENBERG_SIF
    }
}

process {
    withName: 'LONGPHASE' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/longphase/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'WHATSHAP' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/whatshap/${meta.sampleID}/" },
                pattern: "*{vcf,gz,tbi}"
            ]
        ]
    }


    withName: 'MODCALL' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/modcall/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }


    withName: 'SHAPEIT4' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/shapeit4/${meta.sampleID}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'BCFTOOLS_INDEX_4' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/shapeit4/${meta.sampleID}/" },
                pattern: "*{csi,tbi}"
            ]
        ]
    }

    withName: 'BATTENBERG_PHASE' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/battenberg_phase/${meta.sampleID}/" },
                pattern: "*{vcf.gz,tbi}"
            ]
        ]
    }

    withName: 'HAPLOTAG_BAM_T_CORRECTED' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/haplotag_corrected/${meta.sampleID}/${meta.type}/" },
                pattern: "*{bam,haplotag_list}"
            ]
        ]
    }

}

process {
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 2.h    * task.attempt }
    
    maxErrors     = '-1'

    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 10.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 4     * task.attempt }
        memory = { 20.GB * task.attempt }
        time   = { 1.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 8     * task.attempt }
        memory = { 30.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_high_long {
        cpus   = { 12     * task.attempt }
        memory = { 80.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }

    // CN_INFERENCE and CLASSIFY_POSTERIOR (the segment-pooled CN SVI fit and the
    // per-CpG taxonomy classifier): both peaked around 5GB on a real full-size
    // chromosome-scale run (1395, 2026-09-22, execution_trace) after the
    // torch.no_grad()/posterior_draws fix in locate v1.3 -- CN_INFERENCE was
    // previously unbounded (OOM'd past 256GB before that fix). 16GB is ~3x
    // headroom; also covers the ~3h CN_INFERENCE runtime observed with margin.
    withLabel:process_high {
        cpus   = { 4    * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    // METHYLATION_INFERENCE (the older per-CpG infer-asm/BF10 path) genuinely
    // scales with chromosome size, unlike the two labelled process_high above --
    // same run's trace showed chr1 70.6GB, chr2 68.5GB, chr7 58.4GB peak RSS,
    // all of which OOM'd (exit 137) at process_high's 16GB (and would have at the
    // old shared 64GB too) and only passed on Nextflow's automatic retry. Kept as
    // its own label rather than folding into process_high so the two small,
    // cheap-to-schedule processes above aren't stuck requesting this much memory.
    withLabel:process_high_mem {
        cpus   = { 4    * task.attempt }
        memory = { 96.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }

    withLabel:error_retry {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 1) ? 'retry' : 'ignore' }
        maxRetries    = 3
    }
}

process {
    withName: 'SPLIT_ALIGN' {
        errorStrategy = 'retry'
    
        cpus=8
        memory='30 GB'
        time='5h'

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/split/${meta.sampleID}/${meta.type}/" },
                pattern: "*{bam,bai,cram,crai}"
            ]
        ]
    }
}
process {
    withName: 'CLAIR3' {
        cpus=36
        memory='100 GB'
        time='8h'
        errorStrategy = 'retry'

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/variant_calling/clair3/${meta.sampleID}/${meta.type}/${meta.chr}/" },
                pattern: "*{gz,vcf,tbi,log}"
            ]
        ]
    }

    withName: 'CLAIRS' {
        cpus=36
        memory='100 GB'
        time='8h'
        errorStrategy = 'retry'

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/variant_calling/clairS/${meta.sampleID}/" },
                pattern: "*{vcf.gz,vcf,tbi}"
            ]
        ]
    }
}

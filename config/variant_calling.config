process {
    withName: 'CLAIR3' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/variant_calling/clair3/${meta.sampleID}/" },
                pattern: "*{gz,vcf,tbi,log}"
            ]
        ]
    }
    
    withName: 'MPILEUP' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/variant_calling/mpileup/${meta.sampleID}/" },
                pattern: "*{gz,vcf,csi}"
            ]
        ]
    }

    withName: 'CLAIRS' {
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/variant_calling/clairS/${meta.sampleID}/" },
                pattern: "*{vcf.gz,vcf,tbi}"
            ]
        ]
    }
}

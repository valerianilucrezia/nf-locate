process {
    withName: 'PILEUP_CN' {
        errorStrategy = 'ignore' 
	memory = '20 GB'
        time = '10h'
        cpus = 2
        
        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/pileup_cn/${meta.sampleID}/${meta.type}/${meta.chr}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'JOIN_VCF' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        
        memory='20 GB'
        time='2h'
        cpus=2

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/pileup_cn/${meta.sampleID}/${meta.type}/join/" },
                pattern: "*{vcf,gz,csi}"
            ]
        ]
    }


    withName: 'LONGPHASE' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        
        memory='20 GB'
        time='2h'
        cpus=6

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/longphase/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }


    withName: 'BCFTOOLS_INDEX' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        
        memory='20 GB'
        time='2h'
        cpus=2

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/longphase/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf,gz,csi}"
            ]
        ]
    }

    withName: 'MODCALL' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        
        memory='20 GB'
        time='2h'
        cpus=4

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/modcall/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'SNIFFLE' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        
        memory='50 GB'
        time='2h'
        cpus=8

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/sv/sniffle/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'SHAPEIT4' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        
        memory='50 GB'
        time='2h'
        cpus=6

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/shapeit4/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'READ_PHASING' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        memory='30 GB'
        time='1h'

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/read_phasing/${meta.sampleID}/" },
                pattern: "*{RDS}"
            ]
        ]
    }

}

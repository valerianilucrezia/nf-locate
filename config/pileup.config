process {
    withName: 'PILEUP_CN' {
        memory='50 GB'
        time='12h'
        cpus= 12

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/pileup_cn/${meta.sampleID}/${meta.type}/${meta.chr}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'JOIN_VCF' {
        memory='50 GB'
        time='12h'
        cpus= 12

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/pileup_cn/${meta.sampleID}/${meta.type}/join/" },
                pattern: "*{vcf,gz,csi}"
            ]
        ]
    }

    withName: 'WHATSHAP' {
        memory='100 GB'
        time='12h'
        cpus=12

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/whatshap/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'LONGPHASE' {
        memory='50 GB'
        time='12h'
        cpus=12

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/longphase/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }


    withName: 'BCFTOOLS_INDEX' {
        memory='20 GB'
        time='12h'
        cpus=2

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/longphase/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf,gz,csi}"
            ]
        ]
    }

    withName: 'MODCALL' {
        memory='50 GB'
        time='12h'
        cpus=4

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/modcall/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'SNIFFLE' {
        memory='50 GB'
        time='12h'
        cpus=8

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/sv/sniffle/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'SHAPEIT4' {
        memory='20 GB'
        time='12h'
        cpus=12

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/shapeit4/${meta.sampleID}/${meta.type}/" },
                pattern: "*{vcf}"
            ]
        ]
    }

    withName: 'READ_PHASING' {
        memory='30 GB'

        publishDir = [
            [
                mode: 'copy',
                path: { "${params.outdir}/pileup/read_phasing/${meta.sampleID}/" },
                pattern: "*{RDS}"
            ]
        ]
    }

}
params {
    shortread = true
    input = null
    outdir = null

    ref_genome = "/orfeo/scratch/area/lvaleriani/ref/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna"
    ref_fai = "/orfeo/scratch/area/lvaleriani/ref/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.fai"
    
    // optional: local paths to pre-downloaded reference resources.
    // if left as null, nf-locate will download them automatically.
    vcf = null
    map = null
    bcf = null

    // restrict to a subset of chromosomes (e.g. for testing); null = all autosomes 1..22
    test_chromosomes = null

    model_name = "r941_prom_sup_g5014"
    platform = "ont_r9_guppy"

    // somatic variant calling (ClairS)
    run_somatic_calling = false
    // run only the somatic variant calling step, skipping the rest of the pipeline
    somatic_only = false

    // non-haplotype-specific methylation (modkit + DMR)
    run_modkit = false

    // LOCATE: segmentation, copy-number, and methylation inference
    run_locate       = false
    // run only LOCATE_CN + LOCATE_METHYLATION from the outputs of an earlier run
    // (see workflow LOCATE_ONLY in main.nf): needs upstream_dir + locate_samples
    locate_only      = false
    upstream_dir     = null    // results dir of a previous pipeline run (modkit/, battenberg_phase/, longphase/)
    locate_samples   = null    // comma-separated sample IDs, e.g. "1395,1437"
    run_segmentation = true   // required for inferred purity/ploidy (segment-pooled likelihood)

    locate_baf_h1_field    = "BAF_H1"
    locate_baf_h2_field    = "BAF_H2"
    locate_dp_tumor_field  = "DP_T"
    locate_dp_normal_field = "DP_N"
    locate_somatic_af_field = "AF"
    locate_somatic_dp_field = "DP"
    centromere_bed          = null  // optional BED (chrom, start, end) of centromere regions for this genome build
    low_mappability_bed     = "/orfeo/scratch/area/lvaleriani/ref/low_mappability.tsv"  // ENCODE low-mappability regions (chrom, chromStart, chromEnd) -- SNPs here are excluded from CN inference

    segmentation_mode        = "max"
    segmentation_frequencies = "vaf,baf,dr"
    segmentation_window_size = 5   // integer window (validated); MultivariateClaSP does not support "suss"/"fft"/"acf" strings

    // CN inference. Purity and ploidy are INFERRED (not fixed). cn_prior_* are optional
    // soft anchors (null = general prior for cn_sample_type); set cn_fix_* = true only
    // with a trusted external estimate in cn_prior_*. Inferring them needs the
    // segment-pooled likelihood, so run_segmentation must be true.
    cn_steps          = 500
    cn_lr             = 0.05
    cn_guide          = "delta"     // "normal" additionally gives real purity/ploidy posterior draws (saved in the diagnostics .npz)
    cn_hidden_dim     = 6
    cn_sample_type    = "clinical"  // "cell_line" | "clinical"
    cn_prior_purity   = null
    cn_prior_ploidy   = null
    cn_purity_variance = 0.05       // only used when cn_prior_purity is set
    cn_fix_purity     = false
    cn_fix_ploidy     = false
    cn_bp_strength    = 3.0
    cn_max_pos_per_segment = 500
    cn_min_seg_len    = 1

    methylation_model = "binomial"
    methylation_lr    = 1e-2
    methylation_steps = 6000
    // rho (tumor purity) is no longer a fixed param -- METHYLATION_INFERENCE
    // reads it per sample from LOCATE_CN's purity_ploidy output instead.

    asm_a       = 1.0
    asm_b       = 1.0
    asm_pi      = 0.5
    asm_n_draws = 200

    // methylation taxonomy (classify-posterior + refTSS promoter aggregation) --
    // additive alongside the infer-asm/analyze-asm path above, not a replacement.
    // Reorient the normal's H1/H2 against the tumor's phasing before the
    // tumor/normal comparison (needs BATTENBERG_PHASE + LONGPHASE VCFs, so the
    // long-read branch). Required for meaningful TSM/NSM: without it the
    // comparison uses mismatched haplotypes about half the time.
    methylation_reorient          = true
    run_methylation_taxonomy      = true
    methylation_tau_lo            = 0.30
    methylation_tau_hi            = 0.70
    methylation_chunk_size        = 50000
    methylation_sample_batch_size = 100
    methylation_p_asm_threshold   = 0.9
    methylation_p_tsm_threshold   = 0.9
    methylation_p_nsm_threshold   = 0.9

    // refTSS promoter table (export_reftss_promoters.R's output CSV: gene,
    // chrom, strand, tss, prom_start, prom_end). REQUIRED if
    // run_methylation_taxonomy=true -- no vendored default, this is a
    // per-genome-build reference the user must supply.
    reftss_promoters = null

    // optional gene-list CSV/TXT (see `locate methylation build-imprinted-genes`)
    // -- promoters for these genes are dropped from the aggregated output if given
    imprinted_genes  = null

    trace_report_suffix = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    publish_dir_mode = "copy"
}

includeConfig 'config/base.config'
includeConfig 'config/index.config'
includeConfig 'config/phasing.config'
includeConfig 'config/variant_calling.config'
includeConfig 'config/split_align.config'
includeConfig 'config/methylation.config'
includeConfig 'config/download_references.config'
includeConfig 'config/locate.config'


plugins {
  id 'nf-schema@2.0.0'
}


profiles {
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
  }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt" 
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html" 
}

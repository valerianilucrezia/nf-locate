includeConfig 'config/methylation_calling.config'
includeConfig 'config/pileup.config'
includeConfig 'config/variant_calling.config'
includeConfig 'config/split_align.config'
includeConfig 'config/methylation_haplotype.config'

params {
    input = null
    outdir = null

    phasing = 'longphase'

    ref_genome = "/orfeo/scratch/area/lvaleriani/ref/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna"
    ref_fai = "/orfeo/scratch/area/lvaleriani/ref/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.fai"
    bed_file = "/orfeo/scratch/area/lvaleriani/nf-locate/bed_file/pos_short"

    map = "/orfeo/scratch/area/lvaleriani/ref/map_b38"
    bcf = "/orfeo/scratch/area/lvaleriani/ref/bcf_liftover"
}

plugins {
  id 'nf-schema@2.0.0'
}


profiles {
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
  }
}
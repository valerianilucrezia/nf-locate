nextflow.enable.dsl=2
cleanup=false


singularity {
   enabled = true
   envWhitelist = "SINGULARITY_TMPDIR"
   singularity.runOptions = '--bind /orfeo:/orfeo'
   cacheDir = "$NXF_SINGULARITY_CACHEDIR" 
}


process {
    queue='GENOA'
    beforeScript="source /orfeo/scratch/area/lvaleriani/nf-locate/prolog.sh"
    afterScript="source /orfeo/scratch/area/lvaleriani/nf-locate/epilog.sh"
}

executor {
    name = 'slurm'
    queueSize = 40
    submitRateLimit = '1sec'
    pollInterval = '1s'
}
